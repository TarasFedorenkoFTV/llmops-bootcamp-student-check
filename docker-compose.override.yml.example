# Локальний override: у мене на хості вже зайняті 8080 (EDB PEM Apache, PID 4812)
# і 5432 (PostgreSQL 18, PID 6676).
#
# ВАЖЛИВО, чого немає в матеріалах курсу: просто дописати ports у override НЕ ДОПОМАГАЄ.
# Compose зливає list-поля, а не замінює їх — і я отримав ОДРАЗУ ДВА мапінги (8080 і 18080).
# Docker на Windows при цьому не впав з "port is already allocated": Apache і docker-proxy
# обидва сидять на 0.0.0.0:8080, і далі як пощастить з резолвом:
#   localhost:8080   -> [::1] -> docker  -> {"status":"ok"}
#   127.0.0.1:8080   -> IPv4  -> Apache  -> 404
# Тобто "усе працює", поки не використаєш 127.0.0.1 — а Troubleshooting курсу
# саме 127.0.0.1 і радить як фікс проксі-проблем.
#
# Правильно — прибрати успадкований мапінг через !reset (Compose 2.24+).
services:
  service:
    ports: !override ["18080:8080"]
  postgres:
    ports: !override ["15432:5432"]
